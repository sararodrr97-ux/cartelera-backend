# Plantilla de variables de entorno
# En local: copiar este archivo como .env y rellenar los valores
# En producción (Render): configurar estas mismas variables directamente
# en el panel de Render ("Environment"), sin usar ningún archivo .env

PUERTO=3000
MONGO_URI=mongodb://usuario:contraseña@host:27017/?authSource=admin
MONGO_DB_NAME=cartelera
